---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/projects.json';
import { marked } from 'marked';

// GitHub URL에서 README.md를 가져와 HTML로 변환
async function fetchReadme(githubUrl: string): Promise<string | null> {
  try {
    // https://github.com/owner/repo → owner/repo
    const match = githubUrl.match(/github\.com\/([^/]+\/[^/]+)/);
    if (!match) return null;
    const ownerRepo = match[1];
    
    let branch = 'main';
    let rawUrl = `https://raw.githubusercontent.com/${ownerRepo}/${branch}/README.md`;
    let res = await fetch(rawUrl);
    
    if (!res.ok) {
      branch = 'master';
      rawUrl = `https://raw.githubusercontent.com/${ownerRepo}/${branch}/README.md`;
      res = await fetch(rawUrl);
    }
    
    if (!res.ok) return null;
    let md = await res.text();
    // 상대 이미지 경로를 GitHub 절대 경로로 변환
    md = md.replace(/!\[([^\]]*)\]\((?!https?:\/\/)([^)]+)\)/g,
      `![$1](https://raw.githubusercontent.com/${ownerRepo}/${branch}/$2)`);
    return marked.parse(md) as string;
  } catch {
    return null;
  }
}

// 모든 프로젝트의 README를 병렬로 가져오기
const readmeHtmlMap: Record<string, string> = {};
await Promise.all(
  data.projects.map(async (project) => {
    if (project.githubUrl) {
      const html = await fetchReadme(project.githubUrl);
      if (html) readmeHtmlMap[project.githubUrl] = html;
    }
  })
);
---

<BaseLayout title={data.pageTitle}>
  <section class="section">
    <h2 class="section-title">{data.sectionTitle}</h2>

    {data.projects.length === 0 ? (
      <p style="color: var(--color-text-muted);">프로젝트가 곧 추가될 예정입니다.</p>
    ) : (
      [...data.projects].reverse().map(project => {
        const readmeHtml = project.githubUrl && readmeHtmlMap[project.githubUrl];
        return (
          <article class="project-card">
            <div class="project-header">
              <h3>{project.title}</h3>
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="github-link">
                  GitHub ↗
                </a>
              )}
            </div>
            {project.description && <p class="project-desc">{project.description}</p>}

            {project.images && project.images.length > 0 && (
              <div class="project-images">
                {project.images.map((img: { src: string; alt: string }) => (
                  <img src={img.src} alt={img.alt} />
                ))}
              </div>
            )}

            {readmeHtml && (
              <details class="project-readme-toggle">
                <summary>README.md</summary>
                <div class="project-readme" set:html={readmeHtml} />
              </details>
            )}
          </article>
        );
      })
    )}
  </section>
</BaseLayout>
